{
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "^dev-method-claude:(implementer|implementer-high|reviewer)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/check-final-report.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\check-final-report.mjs\"",
            "timeout": 5,
            "statusMessage": "最終報告の到達を確認中"
          }
        ]
      }
    ]
  }
}
